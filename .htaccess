Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI}::$0 ^(.*?/)(.*)::\2$
  RewriteRule ^.*$ - [E=BASE:%1]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_X_FORWARDED_PROTO} !=https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\. [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^bluelotusinfrasafety\.com$ [NC]
  RewriteRule ^ https://www.bluelotusinfrasafety.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{QUERY_STRING} (?:^|&)slug=([^&]+)
  RewriteRule ^product\.html$ %{ENV:BASE}product/%1? [R=301,L]

  RewriteCond %{QUERY_STRING} (?:^|&)cat=([^&]+)
  RewriteRule ^category\.html$ %{ENV:BASE}products/%1? [R=301,L]

  RewriteCond %{QUERY_STRING} (?:^|&)post=([^&]+)
  RewriteRule ^blog-single\.html$ %{ENV:BASE}blog/%1? [R=301,L]

  RewriteRule ^index\.html$ %{ENV:BASE} [R=301,L]
  RewriteRule ^product\.html$ %{ENV:BASE}products [R=301,L]
  RewriteRule ^category\.html$ %{ENV:BASE}products [R=301,L]
  RewriteRule ^blog-single\.html$ %{ENV:BASE}blog [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^services(\.(html|php))?/?$ %{ENV:BASE}faq [R=301,L]

  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(about|products|blog|contact|faq|privacy-policy)\.(html|php)$ %{ENV:BASE}$1 [R=301,L]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^products/?$ products.php [L,QSA]
  RewriteRule ^products/([^/]+)/?$ category.php?cat=$1 [L,QSA]
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blog/([^/]+)/?$ blog-single.php?post=$1 [L,QSA]
  RewriteRule ^(about|contact|faq|privacy-policy)/?$ $1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|README\.md|\.gitignore|config\.local\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.php
